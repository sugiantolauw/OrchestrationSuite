    }
  ],
  "risks": [
    {
      "description": "Ensuring that expense claims are accurate, complete and comply with policy.",
      "key": "risk_expense_accuracy",
      "title": "Expense claim accuracy"
    },
    {
      "description": "Preventing duplicate reimbursement of the same expense.",
      "key": "risk_duplicate_claims",
      "title": "Duplicate expense claims"
    },
    {
      "description": "Detecting claims that are artificially divided to bypass thresholds.",
      "key": "risk_split_claims",
      "title": "Split expense claims"
    },
    {
      "description": "Ensuring payment type codes conform to the approved list.",
      "key": "risk_invalid_payment_type",
      "title": "Invalid payment type"
    },
