# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every workspace-specific value lives here so migration is an environment change,
# not a code change (CLAUDE.md §7).

# ── Workspace ────────────────────────────────────────────────────────────────
DATABRICKS_HOST=https://<workspace-id>.cloud.databricks.com
DATABRICKS_TOKEN=<personal access token>

# ── Unity Catalog ────────────────────────────────────────────────────────────
DBX_CATALOG=<governed catalog>
DBX_SCHEMA=ai_audit_analyst
DBX_VOLUME=/Volumes/<catalog>/ai_audit_analyst/uploads

# ── Compute ──────────────────────────────────────────────────────────────────
DBX_WAREHOUSE_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DBX_APP_NAME=ai-audit-analyst

# ── Model serving (CLAUDE.md §6) ─────────────────────────────────────────────
MODEL_ENDPOINT_HOST=https://<workspace-id>.cloud.databricks.com/serving-endpoints
MODEL_SONNET=databricks-claude-sonnet-4-5
MODEL_GPT_OSS=databricks-gpt-oss-120b

# ── Runtime ──────────────────────────────────────────────────────────────────
# thread = in-App ThreadPoolExecutor. This is the deployed default -- compute runs inside the
# App (CLAUDE.md 2.1). 'jobs' is reserved for a future risk-sensing module only, and would then
# also need DBX_JOB_ID.
EXECUTOR=thread
MAX_CONCURRENT_RUNS=2
DEMO_MODE=false
