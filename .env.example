# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every workspace-specific value lives here so migration is an environment change,
# not a code change (CLAUDE.md §7).

# ── Workspace ────────────────────────────────────────────────────────────────
DATABRICKS_HOST=https://<workspace-id>.cloud.databricks.com
DATABRICKS_TOKEN=<personal access token>

# ── Unity Catalog ────────────────────────────────────────────────────────────
DBX_CATALOG=<governed catalog>
DBX_SCHEMA=ai_audit_analyst
DBX_VOLUME=/Volumes/<catalog>/ai_audit_analyst/uploads

# ── Compute ──────────────────────────────────────────────────────────────────
DBX_WAREHOUSE_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DBX_APP_NAME=ai-audit-analyst

# ── Model serving (CLAUDE.md §6) ─────────────────────────────────────────────
MODEL_ENDPOINT_HOST=https://<workspace-id>.cloud.databricks.com/serving-endpoints
MODEL_SONNET=databricks-claude-sonnet-4-5
MODEL_GPT_OSS=databricks-gpt-oss-120b

# ── Runtime ──────────────────────────────────────────────────────────────────
# thread = in-App ThreadPoolExecutor. This is the deployed default -- compute runs inside the
# App (CLAUDE.md 2.1). 'jobs' is reserved for a future risk-sensing module only, and would then
# also need DBX_JOB_ID.
EXECUTOR=thread
MAX_CONCURRENT_RUNS=2
DEMO_MODE=false
# Landing page "Upload audit files" panel: refuses an upload above this size (build brief P5).
MAX_UPLOAD_MB=100
# Bounded admission retries (CLAUDE.md §2.3 rule 3 / §9C): a queued run whose lease
# repeatedly cannot be acquired retries with exponential backoff, capped at
# ADMISSION_BACKOFF_MAX_S between attempts, and ends `failed` after ADMISSION_MAX_ATTEMPTS
# rather than polling forever.
ADMISSION_MAX_ATTEMPTS=20
ADMISSION_BACKOFF_BASE_S=2
ADMISSION_BACKOFF_MAX_S=60
# Executor admission-loop cadence. The loop otherwise wakes only from an in-process
# signal (start_audit_run/confirm_plan/sign_off/resume_run all call executor.start()
# directly, which admits that run itself and nudges the loop) -- these two only
# govern its safety-sweep polling of the warehouse. ACTIVE applies while this worker
# has a run in flight or is backing off a lease retry. IDLE=0 (the default) turns the
# periodic idle sweep OFF entirely: the loop still reaps orphans and admits any
# already-queued run once, immediately, on every start() (nothing is missed at App
# start), then blocks until the next direct signal -- a single-container deployment
# never needs more than that. Found live: even a 10-minute idle sweep woke a
# 1-minute-auto-stop warehouse ~6x/hour with nothing queued or running, a 15-20% duty
# cycle worth tens of dollars/day. Set IDLE to a positive number of seconds ONLY for a
# multi-container deployment, where a run admitted by one container must still be
# noticed (queued/orphaned) by another that never itself received a direct wake.
EXECUTOR_ACTIVE_POLL_INTERVAL_S=30
EXECUTOR_IDLE_POLL_INTERVAL_S=0

# ── Tracing (CLAUDE.md §2.3, P2/P3 gate review item 4) ────────────────────────
# One MLflow run per pipeline run, one nested run per node attempt. Unset means
# mlflow's own default resolution (a local ./mlruns file store). "databricks"
# selects Databricks-managed tracking; any other mlflow-supported tracking URI
# (e.g. sqlite:///path/to/mlflow.db) also works -- never hardcoded in code.
MLFLOW_TRACKING_URI=databricks
# MLflow on the platform (CLAUDE.md P2/P3 gate review): Databricks-managed
# tracking (MLFLOW_TRACKING_URI=databricks) requires the experiment to be
# named by an ABSOLUTE workspace path, not a bare name -- the adapter's own
# fallback name ("orchestrator-audit-runs") is not one. scripts/deploy_app.py
# derives this from DBX_APP_NAME (e.g. "/Shared/ai-audit-analyst-audit-runs")
# and sets it on the deployed App; set it here only for local runs against a
# real Databricks-managed tracking store. Unset is fine for a local/sqlite
# MLFLOW_TRACKING_URI, where path-ness does not matter.
MLFLOW_EXPERIMENT_PATH=

# ── UCTableDataSource memory guard (CLAUDE.md §2.3 rule 4) ───────────────────
# A read_population() call raises rather than samples if (row_count * selected
# column count) would exceed this many cells. Default when unset: 20_000_000 --
# see orchestrator/adapters/datasource_uc.py.
DBX_MAX_CELLS=20000000

# ── App (app/) ────────────────────────────────────────────────────────────────
# ORCH_BACKEND=local runs the connected App fully offline for local dev/E2E,
# against LocalPersistence + local files under ORCH_LOCAL_DATA_ROOT, surfaced
# in the UI as "Local test data". Any other value (unset in a real deploy)
# selects DeltaPersistence + Unity Catalog, surfaced as "Unity Catalog"
# (orchestrator/service.py). Never set in a corporate deployment.
ORCH_BACKEND=local
ORCH_LOCAL_DB=.local/orchestrator.db
ORCH_LOCAL_DATA_ROOT=synthetic_data
# Dash server port. Databricks Apps serve on DATABRICKS_APP_PORT if set --
# scripts/deploy_app.py maps it to PORT in the deployed app.yaml.
PORT=8050
